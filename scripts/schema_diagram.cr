# Writes DESIGN-schema.md: a fresh store's tables, columns and declared
# foreign keys as a Mermaid ER diagram, which GitHub draws. Run it again
# whenever the schema changes, so the diagram can't drift:
#
#   crystal run scripts/schema_diagram.cr > DESIGN-schema.md
#
# The FTS5 index's own tables (asset_search_*) are left out.
require "file_utils"
require "../src/data_dungeon"

dir = File.tempname("dd-schema")
Dir.mkdir_p(dir)
begin
  path = File.join(dir, "assets.db")
  DataDungeon::DB.new(path, cache_root: File.join(dir, "store")).close
  raw = ::DB.open("sqlite3://#{path}")
  tables = raw.query_all(<<-SQL, as: String)
    SELECT name FROM sqlite_master
    WHERE type = 'table' AND name NOT LIKE 'sqlite_%' AND name NOT LIKE 'asset_search_%' AND sql NOT LIKE 'CREATE VIRTUAL%'
    ORDER BY name
  SQL
  search = raw.query_all("SELECT name FROM sqlite_master WHERE type = 'table' AND sql LIKE 'CREATE VIRTUAL%'", as: String)

  puts "# DataDungeon's schema"
  puts
  puts "*Generated by `scripts/schema_diagram.cr` from a fresh store (DataDungeon #{DataDungeon::VERSION}); don't edit by hand.*"
  puts
  puts "Every table a store has, with its columns and the foreign keys it declares."
  puts "#{search.map { |name| "`#{name}`" }.join(", ")} is SQLite's full-text index (FTS5), whose own tables are left out." unless search.empty?
  puts "A store converted from 0.13 also keeps `recipe_fields`, no longer written."
  puts
  puts "```mermaid"
  puts "erDiagram"
  links = [] of String
  tables.each do |table|
    keys = raw.query_all("SELECT \"from\" FROM pragma_foreign_key_list(?)", table, as: String).to_set
    puts "  #{table} {"
    raw.query_all("SELECT name, type, pk FROM pragma_table_info(?)", table, as: {String, String, Int64}).each do |(name, type, pk)|
      marks = [pk > 0 ? "PK" : nil, keys.includes?(name) ? "FK" : nil].compact
      puts "    #{type.empty? ? "ANY" : type.split(' ').first} #{name}#{marks.empty? ? "" : " #{marks.join(", ")}"}"
    end
    puts "  }"
    raw.query_all("SELECT DISTINCT \"table\", \"from\" FROM pragma_foreign_key_list(?)", table, as: {String, String}).each do |(target, from)|
      links << "  #{target} ||--o{ #{table} : #{from}"
    end
  end
  links.each { |link| puts link }
  puts "```"
  raw.close
ensure
  FileUtils.rm_rf(dir)
end
